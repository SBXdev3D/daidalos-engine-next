# Build output (CMake presets write to build/<preset>)
/build/
/out/

# Local CMake settings
CMakeUserPresets.json

# Files written by the applications when run from the source tree
sandbox.log
/sandbox.cfg
/crashdumps/

# The copy of a level the editor's Play starts the sandbox on
*.play.level.json

# Assets downloaded by scripts/fetch_sample_assets.py
/assets/*/
!/assets/Factory/
!/assets/Fonts/
!/assets/Text/

# vcpkg
/vcpkg_installed/

# IDEs
/.vs/
/.vscode/
/.idea/
*.user

# OS files
.DS_Store
Thumbs.db

# Cached results of texture-tool relief (scripts/convert_factory_textures.py).
assets/Factory/*.cavity

# The showcase kit's downloaded sources (scripts/fetch_showcase_props.py): only converted files are committed.
assets/Factory/Showcase/*/Source/

# The effects gallery preview (scripts/make_effects_gallery.py --only), not a file to keep.
assets/Factory/Sequences/effects_preview.sequence.json
