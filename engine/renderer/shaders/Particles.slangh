#ifndef DAIDALOS_PARTICLES_SLANGH
#define DAIDALOS_PARTICLES_SLANGH

// What the particle passes share (ADR-0025, ADR-0053). Each structure matches its C++ twin in
// engine/renderer/src/ParticlePass.cpp.

#define DAI_NO_MESH_PUSH_CONSTANTS
#include "MeshTypes.slangh"
#include "Random.slangh"

struct Particle {
    float3 position;
    float age;
    float3 velocity;
    float lifetime;
    float size;
    float rotation;
    float rotationSpeed;
    uint effect;
    // A lit particle's light from the frame's lights, per unit of its color, kept from frame to frame: the
    // simulation adds a few samples each frame (ADR-0044).
    float3 light;
    float lightSamples; // Frames of samples it holds; 0 until it is first lit.
    uint4 reservoir;    // The light it keeps choosing (Lights.slangh, Pack).
    float3 axis;        // The effect's axis, turned like the emitter was (ADR-0053).
    float startFrame;   // Its first frame of the flipbook.
    float3 lightDirection; // Towards the light it chose, for six-way light maps; 0 until it has one.
    uint state;            // kParticleResting once it has come to rest on a surface.
};

static const uint kParticleResting = 1;

static const uint kEffectLit = 1;
static const uint kEffectReportsHits = 2;
static const uint kEffectAdditive = 4;
static const uint kEffectLoop = 8;
static const uint kEffectRandomStart = 16;

// No effect: a sub-emitter that spawns nothing, a force that moves every effect.
static const uint kNoEffect = 0xFFFFFFFF;

// renderer::ParticleCollision.
static const uint kCollisionNone = 0;
static const uint kCollisionBounce = 1;
static const uint kCollisionStick = 2;
static const uint kCollisionDie = 3;

// renderer::ParticleShape and renderer::ParticleOrientation.
static const uint kShapeBox = 0;
static const uint kShapeCylinder = 1;
static const uint kShapeCone = 2;
static const uint kShapeLine = 3;
static const uint kOrientCamera = 0;
static const uint kOrientVelocity = 1;
static const uint kOrientAxis = 2;
static const uint kOrientPlane = 3;

struct ParticleEffectData {
    float3 spawnBox;     // Half extents, in the emitter's frame.
    float spawnRadius;   // Added: a random point in a sphere.
    float3 direction;    // In the emitter's frame.
    float spread;        // Radians around the direction.
    float3 axis;         // Of Axis and Plane particles, in the emitter's frame.
    float stretch;       // Seconds of motion a Velocity particle stretches over.
    float speedMin;
    float speedMax;
    float lifeMin;
    float lifeMax;
    float sizeMin;
    float sizeMax;
    float gravity;       // Multiplies the Earth's.
    float drag;          // Fraction of its speed relative to the air lost per second.
    float rotationSpeed; // Radians per second, either way.
    float softness;      // Meters over which it fades into what it touches.
    float bounce;        // Speed kept when it bounces off a surface.
    float fadeIn;        // Fraction of its life over which it fades in.
    float inheritVelocity;
    float frameRate;     // Frames per second of the flipbook; 0 plays it once over the life.
    uint shape;
    uint orientation;
    uint texture;
    uint cell;           // The flipbook's first cell.
    uint columns;
    uint rows;
    uint frames;
    uint flags;
    uint collision;
    uint deathEffect; // Spawned where a particle dies of age, deathCount of it.
    uint deathCount;
    uint hitEffect;   // Spawned where a particle hits a surface, hitCount of it.
    uint hitCount;
    float turbulence;      // Meters per second squared of curl noise.
    float turbulenceScale; // Meters across its swirls.
    float anisotropy;      // Of the light it scatters (Henyey-Greenstein), from -1 back to 1 forwards.
    float distortion;      // Bends the frame behind it by up to this fraction of its height.
    uint lightPositive;    // Six-way light maps: lit from its right, top and front, in RGB, or kNoTexture.
    uint lightNegative;    // From its left, bottom and back.
    uint meshSlot;         // A mesh effect's list of particles to draw (kMaxMeshEffects), or kNoEffect.
    float meshRest;        // How far above a surface a resting mesh's origin is, per unit of its size.
    float padding0;
};

// Mesh effects at once, and the particles each draws (ADR-0053): more are simulated but not drawn.
static const uint kMaxMeshEffects = 32;
static const uint kMeshCapacity = 4096;

// A ribbon's point and the ribbon it belongs to, which the CPU builds each frame (ADR-0053).
struct RibbonPointData {
    float3 position;
    float width;
    float4 color;
    float3 tangent; // Along the ribbon at the point.
    float u;
    uint ribbon;
    uint padding0;
    uint padding1;
    uint padding2;
};
struct RibbonData {
    uint texture;
    uint flags; // kEffectAdditive.
    float softness;
    uint padding;
};
// The key of a ribbon's segment in the sort, besides its index in the frame's segments.
static const uint kRibbonKey = 0x80000000;

struct ParticleSpawn {
    float3 position;
    uint effect;
    float4 rotation; // Quaternion (x, y, z, w) of the emitter.
    float3 previous; // Where the emitter was last frame: particles are spread along the way.
    uint first;      // Particles spawned by the requests before this one.
    float3 velocity; // The emitter's.
    uint count;
};

// New particles that the GPU asks for, where particles died or hit something (ADR-0053): read the next frame.
struct ParticleSubSpawn {
    float3 position;
    uint effect;
    float3 direction; // The new particles' effect direction turns towards it, as an emitter's +Y.
    uint count;
    float3 velocity;  // The particle's, which the new ones inherit as their effect says.
    uint padding;
};

// renderer::WindVolume and renderer::ParticleAttractor, in one kind of record.
static const uint kForceWind = 0;
static const uint kForceAttractor = 1;
struct ParticleForce {
    float4 toBox0; // Wind: the rows of the matrix from the world into its box, the cube from -0.5 to 0.5.
    float4 toBox1;
    float4 toBox2;
    float3 vector; // Wind: its velocity, meters per second. Attractor: its position.
    uint kind;
    float3 axis;   // Attractor: the axis it turns particles around.
    uint effect;   // Attractor: the only effect it moves, or kNoEffect for all.
    float strength;      // Attractor: meters per second squared towards it.
    float vortex;        // Attractor: meters per second squared around its axis.
    float radius;        // Attractor: where its pull fades to nothing; 0 reaches everywhere.
    float gust;          // Wind: how much it varies, from 0 (steady) to 1.
    float gustFrequency; // Wind: gusts per second.
    float edge;          // Wind: the fraction of the box's half-size over which it fades at the faces.
    float padding0;
    float padding1;
};

// A hit reported to the CPU (renderer::ParticleHit). Element 0 of the buffer is its header: the count of
// hits, then the particles alive after the frame.
struct ParticleHitData {
    float3 position;
    uint effect;
    float3 normal;
    uint material;
};

// The simulation's frame, besides the push constants: the air, the forces, and the lists of events.
struct ParticleFrame {
    float3 wind;           // The level's, meters per second.
    uint forceCount;
    float windGust;
    float windGustFrequency;
    uint forces;           // Storage index of the forces.
    uint hits;             // Storage index of this frame's hits, for the CPU.
    uint subSpawnsIn;      // Storage index of the sub-spawns of the last frame, spawned this frame.
    uint subSpawnsOut;     // Storage index of this frame's, spawned the next.
    uint subCounterIn;     // Their counters, in the counters buffer.
    uint subCounterOut;
    uint hitCapacity;
    uint ribbons;        // Storage indices of the frame's ribbons, their points and segments (the first point of
    uint ribbonPoints;   // each, joined to the next).
    uint ribbonSegments;
    uint ribbonSegmentCount;
    uint meshLists; // Storage index of the lists of mesh particles, kMeshCapacity per mesh effect.
    uint padding0;
    uint padding1;
    uint4 meshIndexCounts[kMaxMeshEffects / 4]; // Indices of each mesh effect's mesh; 0 draws nothing.
};

// Requests a frame can make of the next, and the hits it can report.
static const uint kMaxSubSpawns = 4096;

// Every particle pass uses these push constants, each the fields it needs.
struct ParticlePushConstants {
    uint particles;
    uint dead;
    uint aliveIn;
    uint aliveOut;
    uint keys;
    uint counters; // Dead, alive, alive after the simulation.
    uint arguments;
    uint effects;
    uint spawns;
    uint spawnCount;
    uint emitCount;
    uint frameBuffer;
    float timeStep;
    uint seed;
    uint depthTexture;
    uint parameters; // The simulation and sub-emission: the frame's ParticleFrame.
    uint sortBlock;
    uint sortStep;
    uint capacity;
    uint instanceBuffer; // The simulation: the frame's instances and materials, for the alpha test of shadow rays.
    float3 cameraRight;
    uint materialBuffer;
    float3 cameraUp;
    uint curves; // Each effect's curves over life (renderer::BakeParticleCurves).
    uint lightMap; // The simulation: for each of the last frame's lights, its index in this frame's (ADR-0044).
    uint previousLightCount;
};

#ifndef DAI_PARTICLES_NO_PUSH
[[vk::push_constant]] ParticlePushConstants g_particles;
#endif
// Compute passes write the particles; the draws only read them, which needs no device feature.
#ifdef DAI_PARTICLES_READ_ONLY
[[vk::binding(2, 0)]] StructuredBuffer<Particle> g_particleData[];
[[vk::binding(2, 0)]] StructuredBuffer<uint2> g_particleKeys[];
[[vk::binding(2, 0)]] StructuredBuffer<uint> g_particleLists[];
#else
[[vk::binding(2, 0)]] RWStructuredBuffer<Particle> g_particleData[];
[[vk::binding(2, 0)]] RWStructuredBuffer<uint> g_particleLists[];
[[vk::binding(2, 0)]] RWStructuredBuffer<uint2> g_particleKeys[];
#endif
[[vk::binding(2, 0)]] StructuredBuffer<ParticleEffectData> g_particleEffects[];
[[vk::binding(2, 0)]] StructuredBuffer<ParticleSpawn> g_particleSpawns[];
[[vk::binding(2, 0)]] StructuredBuffer<float4> g_particleCurves[];
[[vk::binding(2, 0)]] StructuredBuffer<ParticleFrame> g_particleFrames[];
[[vk::binding(2, 0)]] StructuredBuffer<ParticleForce> g_particleForces[];
[[vk::binding(2, 0)]] StructuredBuffer<RibbonData> g_ribbons[];
[[vk::binding(2, 0)]] StructuredBuffer<RibbonPointData> g_ribbonPoints[];
[[vk::binding(2, 0)]] StructuredBuffer<uint> g_ribbonSegments[];
#ifndef DAI_PARTICLES_READ_ONLY
[[vk::binding(2, 0)]] RWStructuredBuffer<ParticleSubSpawn> g_particleSubSpawns[];
[[vk::binding(2, 0)]] RWStructuredBuffer<ParticleHitData> g_particleHits[];
#endif

// Samples per curve, and the curves of each effect: color, then size, emission and speed.
static const uint kCurveSamples = 256;
static const uint kCurveColor = 0;
static const uint kCurveScales = 1;

// An effect's curve at a moment of the life, from 0 to 1, blended between its samples, from the curves
// buffer of that storage index.
float4 SampleCurveIn(uint curves, uint effect, uint curve, float life) {
    const float x = saturate(life) * float(kCurveSamples - 1);
    const uint i = min(uint(x), kCurveSamples - 2);
    const uint base = (effect * 2 + curve) * kCurveSamples + i;
    return lerp(g_particleCurves[curves][base], g_particleCurves[curves][base + 1], x - float(i));
}
#ifndef DAI_PARTICLES_NO_PUSH
float4 SampleCurve(uint effect, uint curve, float life) {
    return SampleCurveIn(g_particles.curves, effect, curve, life);
}
#endif

static const uint kDeadCounter = 0;
static const uint kAliveCounter = 1;
static const uint kNextAliveCounter = 2;
// Then the two lists of sub-spawns' counters, 3 and 4, which swap each frame; the mesh particles alive, which
// the quads' draw leaves out; and from kMeshCounters, the particles of each mesh effect.
static const uint kMeshAliveCounter = 5;
static const uint kMeshCounters = 8;
// The draw's arguments: the quads', then five per mesh effect, for an indexed draw.
static const uint kMeshArguments = 4;

// A small, good hash (PCG), for random numbers on the GPU.
uint Hash(uint value) {
    const uint state = value * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float3 Rotate(float4 q, float3 v) {
    const float3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

// The product of two rotations, as quaternions (x, y, z, w): b, then a.
float4 MultiplyQuaternions(float4 a, float4 b) {
    return float4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
}

// The shortest rotation from +Y to a unit direction, as a quaternion (x, y, z, w).
float4 RotationFromUp(float3 direction) {
    const float cosine = direction.y;
    if (cosine < -0.9999) {
        return float4(1.0, 0.0, 0.0, 0.0); // Half a turn around X.
    }
    const float3 axis = cross(float3(0.0, 1.0, 0.0), direction);
    return normalize(float4(axis, 1.0 + cosine));
}

#endif
