#ifndef DAIDALOS_AMBIENT_OCCLUSION_SLANGH
#define DAIDALOS_AMBIENT_OCCLUSION_SLANGH

// What the two passes of ambient occlusion share (ADR-0024). Each structure matches its C++ twin in
// engine/renderer/src/AmbientOcclusionPass.cpp.

#define DAI_NO_MESH_PUSH_CONSTANTS
#include "MeshTypes.slangh"

struct AmbientOcclusionPushConstants {
    uint frameBuffer;
    uint depthTexture;
    uint normalTexture;
    uint sourceTexture; // The raw occlusion, for the blur.
    float radius;       // Meters around a pixel where geometry occludes it.
    float intensity;
    float2 sourceTexel; // One texel of the texture read, in texture coordinates.
};

[[vk::push_constant]] AmbientOcclusionPushConstants g_ao;

// One triangle that covers the target.
float4 VSMain(uint vertexId : SV_VulkanVertexID) : SV_Position {
    const float2 corner = float2((vertexId << 1) & 2, vertexId & 2);
    return float4(corner * 2.0 - 1.0, 0.0, 1.0);
}

#endif
