// What every shader that traces rays shares (ADR-0034, ADR-0035): reading the triangle and the material of
// a hit, the alpha test, and the shadow ray, so that the lighting and the path tracer agree by
// construction. Include after MeshTypes.slangh.

#ifndef DAIDALOS_RAY_QUERIES_SLANGH
#define DAIDALOS_RAY_QUERIES_SLANGH

[[vk::binding(2, 0)]] StructuredBuffer<uint> g_indices[];
[[vk::binding(3, 0)]] RaytracingAccelerationStructure g_accelerationStructures[];

// Match the masks in renderer/src/RayTracingScene.hpp: each kind of ray sees what has its bit (ADR-0059).
static const uint kMaskShadow = 0x01;
static const uint kMaskCamera = 0x02;
static const uint kMaskReflection = 0x04;
static const uint kMaskIndirect = 0x08;
// Only the glass pass and the path tracer see glass (ADR-0042).
static const uint kMaskGlass = 0x10;
static const uint kMaskCollision = 0x20;
// Particles' shadows (ADR-0062): shadow rays see them, but for the particles' own, cast while they move.
static const uint kMaskParticleShadow = 0x40;
#ifdef DAI_SHADOWS_SKIP_PARTICLES
static const uint kMaskShadows = kMaskShadow;
#else
static const uint kMaskShadows = kMaskShadow | kMaskParticleShadow;
#endif
// What rays of bounced light and reflections see, but for glass.
static const uint kMaskSurfaces = kMaskReflection | kMaskIndirect;
static const uint kMaskAll = 0xFF;
// Nothing this close to a light shadows it: a lamp's own shade, around the light, would darken it.
static const float kShadowNearPlane = 0.1;

struct Vertex {
    float3 position;
    float3 normal;
    float4 tangent;
    float2 uv;
};

Vertex LoadVertex(InstanceData instance, uint index) {
    const uint first = (instance.firstVertex + index) * kVertexFloats;
    const uint buffer = instance.vertexBuffer;
    Vertex vertex;
    vertex.position = float3(g_vertexFloats[buffer][first], g_vertexFloats[buffer][first + 1], g_vertexFloats[buffer][first + 2]);
    vertex.normal = float3(g_vertexFloats[buffer][first + 3], g_vertexFloats[buffer][first + 4], g_vertexFloats[buffer][first + 5]);
    vertex.tangent = float4(g_vertexFloats[buffer][first + 6], g_vertexFloats[buffer][first + 7], g_vertexFloats[buffer][first + 8],
                            g_vertexFloats[buffer][first + 9]);
    vertex.uv = float2(g_vertexFloats[buffer][first + 10], g_vertexFloats[buffer][first + 11]);
    return vertex;
}

// The three vertices of a triangle, blended by the barycentric coordinates of a hit.
Vertex Interpolate(InstanceData instance, uint primitive, float2 barycentrics) {
    const uint first = primitive * 3;
    const Vertex a = LoadVertex(instance, g_indices[instance.indexBuffer][first]);
    const Vertex b = LoadVertex(instance, g_indices[instance.indexBuffer][first + 1]);
    const Vertex c = LoadVertex(instance, g_indices[instance.indexBuffer][first + 2]);
    const float3 w = float3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);
    Vertex result;
    result.position = a.position * w.x + b.position * w.y + c.position * w.z;
    result.normal = a.normal * w.x + b.normal * w.y + c.normal * w.z;
    result.tangent = a.tangent * w.x + b.tangent * w.y + c.tangent * w.z;
    result.uv = a.uv * w.x + b.uv * w.y + c.uv * w.z;
    // The handedness of the tangent frame is a sign, not something to blend.
    result.tangent.w = a.tangent.w;
    return result;
}

float3 FaceNormal(InstanceData instance, uint primitive) {
    const uint first = primitive * 3;
    const float3 a = LoadVertex(instance, g_indices[instance.indexBuffer][first]).position;
    const float3 b = LoadVertex(instance, g_indices[instance.indexBuffer][first + 1]).position;
    const float3 c = LoadVertex(instance, g_indices[instance.indexBuffer][first + 2]).position;
    return TransformNormal(instance.world, cross(b - a, c - a));
}

// Rays have no screen derivatives: textures are read at their full detail, unless a ray cone says otherwise.
float4 SampleLevelZero(uint texture, float2 uv, float4 fallback) {
    return texture != kNoTexture ? g_textures[texture].SampleLevel(g_samplers[kSamplerLinearRepeat], uv, 0.0) : fallback;
}

// Texture detail by ray cone (ADR-0101; Akenine-Moller et al., "Texture Level of Detail Strategies for
// Real-Time Ray Tracing", 2019). A ray stands for a cone as wide as a pixel where it left the camera; where it
// hits, the cone's footprint covers so many texels, and the mip that averages them is read. The width grows
// with the distance travelled from the camera and with how slanted the surface is. Bounces do not widen it by
// their lobe: a mirror's reflection keeps the detail the screen would show, and rougher rays are sharper than
// they need, never blurrier.

// The angle one pixel of the frame spans, from the camera: twice the tangent of half the field of view over
// the render height.
float PixelSpread(FrameData frame) {
    const float4 center = mul(frame.inverseViewProjection, float4(0.0, 0.0, 1.0, 1.0));
    const float4 below = mul(frame.inverseViewProjection, float4(0.0, -2.0 / float(frame.renderSize.y), 1.0, 1.0));
    return length(normalize(below.xyz / below.w - frame.cameraPosition) -
                  normalize(center.xyz / center.w - frame.cameraPosition));
}

// What the mip of a texture of one texel per unit of texture coordinates would be at a hit: the triangle's
// texture area over its world area, and the cone's width over how squarely it meets the surface. A texture of
// w by h texels adds half of log2(w h). Returns kFullDetail without a cone.
static const float kFullDetail = -1e6;

float ConeLevel(InstanceData instance, uint primitive, float3 rayDirection, float coneWidth) {
    if (coneWidth <= 0.0) {
        return kFullDetail;
    }
    const uint first = primitive * 3;
    const Vertex a = LoadVertex(instance, g_indices[instance.indexBuffer][first]);
    const Vertex b = LoadVertex(instance, g_indices[instance.indexBuffer][first + 1]);
    const Vertex c = LoadVertex(instance, g_indices[instance.indexBuffer][first + 2]);
    const float3 worldCross = cross(mul((float3x3)instance.world, b.position - a.position),
                                    mul((float3x3)instance.world, c.position - a.position));
    const float2 du = b.uv - a.uv;
    const float2 dv = c.uv - a.uv;
    const float textureArea = abs(du.x * dv.y - du.y * dv.x);
    const float worldArea = length(worldCross);
    if (textureArea <= 0.0 || worldArea <= 0.0) {
        return kFullDetail;
    }
    const float slant = max(abs(dot(worldCross / worldArea, rayDirection)), 0.05);
    return 0.5 * log2(textureArea / worldArea) + log2(coneWidth / slant);
}

float4 SampleCone(uint texture, float2 uv, float level, float4 fallback) {
    if (texture == kNoTexture) {
        return fallback;
    }
    if (level <= kFullDetail) {
        return g_textures[texture].SampleLevel(g_samplers[kSamplerLinearRepeat], uv, 0.0);
    }
    uint width;
    uint height;
    uint levels;
    g_textures[texture].GetDimensions(0, width, height, levels);
    const float mip = clamp(level + 0.5 * log2(float(width) * float(height)), 0.0, float(levels - 1));
    return g_textures[texture].SampleLevel(g_samplers[kSamplerLinearRepeat], uv, mip);
}

// The alpha test of the G-buffer, for a candidate hit on a surface that is not opaque. The buffers are
// the storage indices of the frame's instances and of the material table.
bool PassesAlphaTest(uint instanceBuffer, uint materialBuffer, uint instanceIndex, uint primitive, float2 barycentrics) {
    const InstanceData instance = g_instances[instanceBuffer][instanceIndex];
    const MaterialData material = g_materials[materialBuffer][instance.material];
    const float2 uv = Interpolate(instance, primitive, barycentrics).uv;
    const float alpha = material.baseColorFactor.a * SampleLevelZero(material.baseColorTexture, uv, float4(1.0, 1.0, 1.0, 1.0)).a;
    return alpha >= material.alphaCutoff;
}

// Particles in the frame's structure (ADR-0062): a box around each, which rays that enter test themselves. A
// ray meets a particle as a disc facing it, at its center, or a spark's streak as a segment along its motion,
// whatever way it comes from, with the particle's image, color and opacity as the screen shows them. Its
// opacity is a chance of stopping the ray: smoke's shadows and reflections are dithered, and the denoisers and
// the temporal resolve smooth them.
#include "ParticleTypes.slangh"

[[vk::binding(2, 0)]] StructuredBuffer<Particle> g_tracedParticles[];
[[vk::binding(2, 0)]] StructuredBuffer<ParticleEffectData> g_tracedEffects[];
[[vk::binding(2, 0)]] StructuredBuffer<float4> g_tracedCurves[];

// The instance of the particles in the frame's structure: its custom index.
static const uint kParticleInstance = 0xFFFFFF;

uint ParticleHash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352d;
    value ^= value >> 15;
    value *= 0x846ca68b;
    value ^= value >> 16;
    return value;
}

// Where a ray meets a particle, and what it sees there: the light it sends back, and its opacity.
struct ParticleCrossing {
    bool found;
    float distance;
    float4 look;
};

// Whether the ray from origin along the unit direction meets the particle of that index between tMin and tMax.
// Shadow rays pass through what gives off light (additive particles); other rays pass through mesh particles,
// which are drawn in the G-buffer but only cast shadows here, as balls of their size.
ParticleCrossing CrossParticle(FrameData frame, float3 origin, float3 direction, uint index, float tMin, float tMax,
                               bool shadow) {
    ParticleCrossing crossing;
    crossing.found = false;
    crossing.distance = 0.0;
    crossing.look = float4(0.0, 0.0, 0.0, 0.0);
    const Particle particle = g_tracedParticles[frame.particleData][index];
    const ParticleEffectData effect = g_tracedEffects[frame.particleEffects][particle.effect];
    const bool mesh = effect.meshSlot != kNoEffect;
    if ((effect.flags & kEffectTraced) == 0 || (shadow ? (effect.flags & kEffectAdditive) != 0 : mesh)) {
        return crossing;
    }
    const float life = saturate(particle.age / particle.lifetime);
    const float4 scales = SampleCurveFrom(g_tracedCurves[frame.particleCurves], particle.effect, kCurveScales, life);
    const float halfSize = max(particle.size * scales.x * 0.5, 1e-4);
    const float t = dot(particle.position - origin, direction);
    if (t < tMin || t > tMax) {
        return crossing;
    }
    const float3 offset = origin + direction * t - particle.position;
    float2 corner;
    const float3 velocity = particle.velocity * scales.z;
    const float speed = length(velocity);
    if (mesh) {
        corner = float2(length(offset) / halfSize, 0.0);
    } else if (effect.orientation == kOrientVelocity && speed > 1.0e-4) {
        const float3 along = velocity / speed;
        const float a = dot(offset, along);
        corner = float2(length(offset - along * a) / halfSize, a / (halfSize + 0.5 * speed * effect.stretch));
    } else {
        const float3 helper = abs(direction.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
        const float3 right = normalize(cross(helper, direction));
        const float3 up = cross(direction, right);
        corner = float2(dot(offset, right), dot(offset, up)) / halfSize;
    }
    if (any(abs(corner) > 1.0)) {
        return crossing;
    }
    float4 look = float4(1.0, 1.0, 1.0, 1.0);
    if (!mesh) {
        look = SampleCurveFrom(g_tracedCurves[frame.particleCurves], particle.effect, kCurveColor, life);
        look.rgb *= scales.y;
        look.a *= effect.fadeIn > 0.0 ? saturate(life / effect.fadeIn) : 1.0;
        if (effect.texture != kNoTexture) {
            const Flipbook flipbook = FlipbookAt(effect, particle, life);
            look *= g_textures[effect.texture].SampleLevel(g_samplers[kSamplerLinearClamp],
                                                           CellUv(effect, effect.cell + flipbook.current, corner), 0.0);
        }
        if ((effect.flags & kEffectLit) != 0) {
            // The light the simulation found at the particle (ADR-0044), as the screen shows it.
            look.rgb *= particle.light;
        }
    }
    // A chance of stopping the ray as its opacity, drawn anew as the ray moves.
    const uint seed =
        ParticleHash(asuint(origin.x) ^ ParticleHash(asuint(origin.y) ^ ParticleHash(asuint(origin.z) + index)));
    crossing.found = look.a > float(seed & 0xFFFF) / 65536.0;
    crossing.distance = t;
    crossing.look = look;
    return crossing;
}

// The first surface a ray meets, alpha-tested surfaces included, or a particle.
struct Hit {
    bool found;
    uint instance;
    uint primitive;
    float2 barycentrics;
    float distance;
    bool particle;        // The ray met a particle (ADR-0062): primitive is its index; instance is not one.
    float3 particleLight; // What the ray sees of the particle.
};

Hit TraceClosest(RayDesc ray, FrameData frame, uint instanceBuffer, uint materialBuffer, uint mask = kMaskSurfaces) {
    RayQuery<RAY_FLAG_NONE> query;
    query.TraceRayInline(g_accelerationStructures[frame.accelerationStructure], RAY_FLAG_NONE, mask, ray);
    float3 particleLight = float3(0.0, 0.0, 0.0);
    while (query.Proceed()) {
        if (query.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE) {
            if (PassesAlphaTest(instanceBuffer, materialBuffer, query.CandidateInstanceID(), query.CandidatePrimitiveIndex(),
                                query.CandidateTriangleBarycentrics())) {
                query.CommitNonOpaqueTriangleHit();
            }
        } else if (query.CandidateType() == CANDIDATE_PROCEDURAL_PRIMITIVE) {
            const float limit = query.CommittedStatus() != COMMITTED_NOTHING ? query.CommittedRayT() : ray.TMax;
            const ParticleCrossing crossing =
                CrossParticle(frame, ray.Origin, ray.Direction, query.CandidatePrimitiveIndex(), ray.TMin, limit, false);
            if (crossing.found) {
                particleLight = crossing.look.rgb;
                query.CommitProceduralPrimitiveHit(crossing.distance);
            }
        }
    }
    Hit hit;
    hit.found = query.CommittedStatus() != COMMITTED_NOTHING;
    hit.particle = query.CommittedStatus() == COMMITTED_PROCEDURAL_PRIMITIVE_HIT;
    hit.instance = query.CommittedInstanceID();
    hit.primitive = query.CommittedPrimitiveIndex();
    hit.barycentrics = hit.particle ? float2(0.0, 0.0) : query.CommittedTriangleBarycentrics();
    hit.distance = query.CommittedRayT();
    hit.particleLight = particleLight;
    return hit;
}

// Whether anything that casts shadows lies on the ray.
bool Occluded(RayDesc ray, FrameData frame, uint instanceBuffer, uint materialBuffer) {
    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
    query.TraceRayInline(g_accelerationStructures[frame.accelerationStructure], RAY_FLAG_NONE, kMaskShadows, ray);
    while (query.Proceed()) {
        if (query.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE) {
            if (PassesAlphaTest(instanceBuffer, materialBuffer, query.CandidateInstanceID(), query.CandidatePrimitiveIndex(),
                                query.CandidateTriangleBarycentrics())) {
                query.CommitNonOpaqueTriangleHit();
            }
        } else if (query.CandidateType() == CANDIDATE_PROCEDURAL_PRIMITIVE) {
            const ParticleCrossing crossing =
                CrossParticle(frame, ray.Origin, ray.Direction, query.CandidatePrimitiveIndex(), ray.TMin, ray.TMax, true);
            if (crossing.found) {
                query.CommitProceduralPrimitiveHit(crossing.distance);
            }
        }
    }
    return query.CommittedStatus() != COMMITTED_NOTHING;
}

// The surface at a hit, as the G-buffer holds it: its material, read at full detail, and its normal,
// with the normal map, turned towards the ray as the G-buffer does for the back of double-sided surfaces.
import Bsdf;
#include "Decals.slangh"
#include "Wetness.slangh"

struct Surface {
    float3 position;
    float3 faceNormal;
    float3 normal;
    float3 diffuseColor;
    float3 f0;
    float roughness;
    float3 emission;
    bool emissiveLight; // The emission is a light (ADR-0044).
    // Glass (ADR-0042): transmission above zero. The ray hit the face its normal points out of.
    float transmission;
    float ior;
    bool thin;
    float3 absorption;
    float3 tint; // The base color, which tints the light that goes through.
    bool entering;
    Layers layers; // The clear coat and the sheen (ADR-0056).
};

// A particle a ray met: only the light it sends back, as the screen shows it, facing the ray.
Surface ParticleSurface(Hit hit, float3 rayDirection, FrameData frame) {
    Surface surface;
    surface.position = g_tracedParticles[frame.particleData][hit.primitive].position;
    surface.faceNormal = -rayDirection;
    surface.normal = -rayDirection;
    surface.diffuseColor = float3(0.0, 0.0, 0.0);
    surface.f0 = float3(0.0, 0.0, 0.0);
    surface.roughness = 1.0;
    surface.emission = hit.particleLight;
    surface.emissiveLight = false;
    surface.transmission = 0.0;
    surface.ior = 1.0;
    surface.thin = false;
    surface.absorption = float3(0.0, 0.0, 0.0);
    surface.tint = float3(0.0, 0.0, 0.0);
    surface.entering = true;
    surface.layers.coat = 0.0;
    surface.layers.coatRoughness = 0.0;
    surface.layers.sheen = float3(0.0, 0.0, 0.0);
    surface.layers.sheenRoughness = 0.0;
    return surface;
}

// coneWidth: the width of the ray's cone where it hits, in meters (ADR-0101), or 0 for full detail.
Surface ShadeHit(Hit hit, float3 rayDirection, FrameData frame, uint instanceBuffer, uint materialBuffer,
                 float coneWidth = 0.0) {
    if (hit.particle) {
        return ParticleSurface(hit, rayDirection, frame);
    }
    const InstanceData instance = g_instances[instanceBuffer][hit.instance];
    const MaterialData material = g_materials[materialBuffer][instance.material];
    const Vertex vertex = Interpolate(instance, hit.primitive, hit.barycentrics);
    const float level = ConeLevel(instance, hit.primitive, rayDirection, coneWidth);

    Surface surface;
    surface.position = mul(instance.world, float4(vertex.position, 1.0)).xyz;
    surface.faceNormal = normalize(FaceNormal(instance, hit.primitive));
    float3 normal = normalize(TransformNormal(instance.world, vertex.normal));
    float4 tangent = float4(mul((float3x3)instance.world, vertex.tangent.xyz), vertex.tangent.w);
    surface.entering = dot(surface.faceNormal, rayDirection) <= 0.0;
    if (!surface.entering) {
        surface.faceNormal = -surface.faceNormal;
        normal = -normal;
        tangent.w = -tangent.w;
    }
    if (material.normalTexture != kNoTexture && dot(tangent.xyz, tangent.xyz) > 0.0) {
        const float3 t = normalize(tangent.xyz - normal * dot(normal, tangent.xyz));
        const float3 b = cross(normal, t) * (tangent.w < 0.0 ? -1.0 : 1.0);
        float2 xy = SampleCone(material.normalTexture, vertex.uv, level, float4(0.5, 0.5, 1.0, 1.0)).rg * 2.0 - 1.0;
        xy *= material.normalScale * frame.normalStrength;
        const float z = sqrt(saturate(1.0 - dot(xy, xy)));
        normal = normalize(t * xy.x + b * xy.y + normal * z);
    }
    surface.normal = normal;

    float4 baseColor = material.baseColorFactor * SampleCone(material.baseColorTexture, vertex.uv, level, float4(1.0, 1.0, 1.0, 1.0));
    // glTF: roughness in green, metalness in blue.
    const float4 metallicRoughness = SampleCone(material.metallicRoughnessTexture, vertex.uv, level, float4(1.0, 1.0, 1.0, 1.0));
    float metallic = saturate(material.metallicFactor * metallicRoughness.b);
    surface.roughness = clamp(material.roughnessFactor * metallicRoughness.g, 0.045, 1.0);
    // Decals show in reflections and bounced light as on screen (ADR-0060), at a detail the hit's distance allows.
    ApplyDecals(frame, instance.decalMask, surface.position, hit.distance * 0.002, baseColor.rgb, metallic,
                surface.roughness, surface.normal);
    surface.layers.coat = material.clearcoat;
    surface.layers.coatRoughness = material.clearcoatRoughness;
    surface.layers.sheen = material.sheenColor;
    surface.layers.sheenRoughness = material.sheenRoughness;
    ApplyWetness(frame, surface.position, surface.faceNormal, material.porosity, baseColor.rgb, surface.roughness,
                 surface.normal, surface.layers);
    surface.diffuseColor = baseColor.rgb * (1.0 - metallic);
    surface.f0 = lerp(float3(0.04, 0.04, 0.04), baseColor.rgb, metallic);
    // Nits, times the frame's exposure (ADR-0043).
    surface.emission = material.emissiveFactor *
                       SampleCone(material.emissiveTexture, vertex.uv, level, float4(1.0, 1.0, 1.0, 1.0)).rgb * frame.exposure *
                       instance.emissiveScale;
    surface.emissiveLight = material.emissiveLight != 0;

    surface.transmission = material.transmission;
    surface.ior = material.ior;
    surface.thin = material.thin != 0;
    surface.absorption = material.absorption;
    surface.tint = baseColor.rgb;
    return surface;
}

// Moves a ray's origin off the surface it starts from, so that it does not hit it again.
float3 OffsetOrigin(float3 position, float3 faceNormal) {
    return position + faceNormal * (1e-3 * (1.0 + max(abs(position.x), max(abs(position.y), abs(position.z))) * 0.01));
}

// A point of a light that is a sphere of this radius, as seen from position, from two uniform random numbers:
// uniformly on the disk of the sphere that faces position (ADR-0039). Shadow rays aimed at such points
// make the shadow soft; a light without a radius is its center, and its shadows hard.
float3 SampleLightPoint(float3 lightPosition, float radius, float3 position, float2 u) {
    if (radius <= 0.0) {
        return lightPosition;
    }
    const float3 axis = normalize(position - lightPosition);
    // An orthonormal frame around the axis (Duff et al. 2017).
    const float sign = axis.z >= 0.0 ? 1.0 : -1.0;
    const float a = -1.0 / (sign + axis.z);
    const float c = axis.x * axis.y * a;
    const float3 tangent = float3(1.0 + sign * axis.x * axis.x * a, sign * c, -sign * axis.x);
    const float3 bitangent = float3(c, sign + axis.y * axis.y * a, -axis.y);
    const float distance = radius * sqrt(u.x);
    const float angle = 6.28318531 * u.y;
    return lightPosition + (tangent * cos(angle) + bitangent * sin(angle)) * distance;
}

// Whether the light at distanceToLight along the unit vector toLight reaches position, on a surface whose
// face points along faceNormal. The ray stops kShadowNearPlane short of the light (ADR-0035).
bool LightReaches(float3 position, float3 faceNormal, float3 toLight, float distanceToLight, float lightRange,
                  FrameData frame, uint instanceBuffer, uint materialBuffer) {
    RayDesc ray;
    ray.Origin = OffsetOrigin(position, faceNormal);
    ray.Direction = toLight;
    ray.TMin = 0.0;
    ray.TMax = max(distanceToLight - min(kShadowNearPlane, lightRange * 0.5), 0.0);
    return !Occluded(ray, frame, instanceBuffer, materialBuffer);
}

#endif
