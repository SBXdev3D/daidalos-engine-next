#ifndef DAIDALOS_MESH_TYPES_SLANGH
#define DAIDALOS_MESH_TYPES_SLANGH

// Each structure matches its C++ twin in engine/renderer/src/MeshPass.cpp.

// Indices only: everything else is in storage buffers.
struct MeshPushConstants {
    uint frameBuffer;
    uint instanceBuffer;
    uint materialBuffer;
    uint instanceIndex;
    uint materialIndex;
};

struct FrameData {
    float4x4 viewProjection;
    float4x4 inverseViewProjection;
    float3 cameraPosition;
    float fogDensity;
    float3 fogColor;
    uint lightCount;      // Analytic lights, in lightBuffer; the emissive triangles come after them (ADR-0044).
    uint lightBuffer;
    uint skyTexture;      // Index in g_cubeTextures, or kNoTexture for no sky.
    float skyIntensity;   // Multiplies the sky's colors: their luminance in nits, times the exposure.
    uint frameIndex;      // Counts the frames, for what changes from one to the next, such as noise.
    float normalStrength; // Multiplies every normal map's tilt.
    uint indirectTexture; // Indirect diffuse light per unit of diffuse color (ADR-0040), or kNoTexture.
    float2 screenTexel;   // One pixel of the frame, in texture coordinates.
    float nearPlane;      // Of the camera: LinearDepth turns a depth into meters.
    uint sourceCount;     // What the alias table draws: the analytic lights, then the emissive draws.
    uint aliasBuffer;     // The alias table of the sources, by power (Lights.slangh).
    float farPlane;       // Nothing is drawn beyond it: the view distance.
    float3 cameraForward;
    uint emissiveDrawBuffer;    // The emissive draws, the sources after the analytic lights.
    uint accelerationStructure; // The frame's top-level structure in g_accelerationStructures.
    float skyYaw;               // Radians the sky is turned about +Y (ADR-0040).
    float2 jitter; // Where each pixel samples the scene, relative to its center, in texture coordinates.
    // Without the jitter of temporal antialiasing (ADR-0037): motion vectors compare these two.
    float4x4 unjitteredViewProjection;
    float4x4 previousViewProjection;
    uint reflectionTexture; // The light each pixel's specular lobe reflects (ADR-0042), or kNoTexture.
    uint backgroundTexture; // The glass pass's copy of the frame before glass (ADR-0042).
    uint depthTexture;      // The G-buffer's depth, for the glass pass.
    // What luminance in nits is multiplied by on the GPU (ADR-0043): lights and the sky come multiplied
    // already, emission is multiplied by it where it is read.
    float exposure;
    uint emissiveTriangleBuffer; // The triangles of the emissive draws, in world space.
    uint emissiveTriangleCount;
    // Smoother surfaces trace a sharp reflection, which shows emissive lights: light sampling leaves out their
    // specular light there, so that each is counted once (ADR-0044). 0 without reflections.
    float sharpReflections;
    uint framePadding;
};

// Where a point of clip space is on the screen, in texture coordinates: y goes down (CONVENTIONS.md,
// section 5).
float2 ClipToUv(float4 clip) {
    return clip.xy / clip.w * float2(0.5, -0.5) + 0.5;
}

// Where the surface behind a pixel is, from its reverse-Z depth and its position in texture coordinates.
float3 WorldPosition(FrameData frame, float2 uv, float depth) {
    const float4 position = mul(frame.inverseViewProjection, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0));
    return position.xyz / position.w;
}

// Meters in front of the camera, from a reverse-Z depth: 1 at the near plane, 0 at the far plane.
float LinearDepth(FrameData frame, float depth) {
    return frame.nearPlane * frame.farPlane / (depth * (frame.farPlane - frame.nearPlane) + frame.nearPlane);
}

// The kinds of light: lights with a position, and directional lights, infinitely far (ADR-0040).
static const uint kLightNear = 0;
static const uint kLightDirectional = 1;

// A point light has a cosOuter of -2, which every direction passes. Physical units (ADR-0043), times the
// frame's exposure: color is in candela, or lux for a directional light.
struct LightData {
    float3 position;
    float range; // Meters: the light fades to zero there.
    float3 direction;
    float spare;
    float3 color;
    float cosOuter;
    float cosInner;
    float radius; // Meters: a sphere whose shadows are soft; 0 is a point (ADR-0039). Directional
                  // lights: the tangent of their angular radius.
    uint kind;
    uint padding;
};

// How far a directional light is put from the point it lights: beyond anything in a level.
static const float kDirectionalDistance = 10000.0;

// The light as seen from position. A directional light becomes a light far away against its direction, as
// large as its disk, so that every kind of light is shaded, and casts its shadows, the same way.
LightData LightAt(LightData light, float3 position) {
    if (light.kind == kLightDirectional) {
        light.position = position - light.direction * kDirectionalDistance;
        light.range = kDirectionalDistance * 2.0;
        light.radius *= kDirectionalDistance;
    }
    return light;
}

// One per draw of the frame, in the order of the sorted draws; also what a ray hit's custom index points to.
// A skinned draw's vertices were skinned by the frame's skinning pass, in world space: its world is identity.
struct InstanceData {
    float4x4 world;
    uint vertexBuffer; // Storage index of the vertices, kVertexFloats floats each.
    uint firstVertex;  // Of the draw, in vertexBuffer.
    uint indexBuffer;  // Storage index of the 32-bit indices.
    uint material;
    float4x4 previousWorld; // Where the draw was in the previous frame (ADR-0037).
    // A skinned draw's positions in the previous frame, three floats per vertex from firstVertex, in
    // world space; kNoTexture for a rigid draw.
    uint previousPositions;
    uint padding0; // Not a uint3, which would be aligned to 16 bytes.
    uint2 padding;
};


// Floats per vertex: position, normal, tangent and uv, as resources::Vertex.
static const uint kVertexFloats = 12;

// One per joint of the frame's skinned draws: its world matrix times its inverse bind matrix.
struct JointData {
    float4x4 matrix;
};

// Matches resources::SkinWeights: four 16-bit joint indices, then four weights. The weights are
// separate floats, so that the structure keeps the 24 bytes of its twin.
struct SkinVertex {
    uint joints01;
    uint joints23;
    float weight0;
    float weight1;
    float weight2;
    float weight3;
};

static const uint kNoTexture = 0xFFFFFFFF;

struct MaterialData {
    float4 baseColorFactor;
    float3 emissiveFactor;
    float metallicFactor;
    float roughnessFactor;
    float normalScale;
    float occlusionStrength;
    float alphaCutoff;
    uint baseColorTexture;
    uint metallicRoughnessTexture;
    uint normalTexture;
    uint occlusionTexture;
    uint emissiveTexture;
    float transmission; // Above zero, glass (ADR-0042): the fraction of the light that goes through.
    float ior;
    uint thin;          // 1: thin glass, which bends nothing; 0: a closed volume.
    float3 absorption;  // Thick glass: exp(-absorption * meters) of each color goes through.
    uint emissiveLight; // 1: its emission lights the scene (ADR-0044); 0: it is only seen.
};

// Fullscreen passes declare their own push constants.
#ifndef DAI_NO_MESH_PUSH_CONSTANTS
[[vk::push_constant]] MeshPushConstants g_push;
#endif
[[vk::binding(0, 0)]] Texture2D g_textures[];
[[vk::binding(1, 0)]] SamplerState g_samplers[4];
[[vk::binding(5, 0)]] TextureCube g_cubeTextures[];
[[vk::binding(2, 0)]] StructuredBuffer<FrameData> g_frames[];
[[vk::binding(2, 0)]] StructuredBuffer<InstanceData> g_instances[];
[[vk::binding(2, 0)]] StructuredBuffer<MaterialData> g_materials[];
[[vk::binding(2, 0)]] StructuredBuffer<JointData> g_joints[];
[[vk::binding(2, 0)]] StructuredBuffer<SkinVertex> g_skins[];
[[vk::binding(2, 0)]] StructuredBuffer<LightData> g_lights[];
// Vertices read as floats, kVertexFloats each, and the previous positions of skinned vertices.
[[vk::binding(2, 0)]] StructuredBuffer<float> g_vertexFloats[];

// Matches rhi::SamplerIndex.
static const uint kSamplerLinearClamp = 0;
static const uint kSamplerLinearRepeat = 1;
static const uint kSamplerNearestClamp = 2;
static const uint kSamplerShadowCompare = 3;

// What a light's color is multiplied by to give the illuminance it makes at a point, facing it, in lux
// (ADR-0043): the inverse square of the distance, faded to zero at the light's range by a smooth window
// (Karis, "Real Shading in Unreal Engine 4", 2013), never nearer than the surface of its sphere; inside the
// cone of a spot light. A directional light's color is its illuminance already.
float Attenuation(LightData light, float distanceToLight, float3 toLight) {
    const float cone = smoothstep(light.cosOuter, light.cosInner, dot(-toLight, light.direction));
    if (light.kind == kLightDirectional) {
        return cone;
    }
    const float ratio = distanceToLight / light.range;
    const float ratio2 = ratio * ratio;
    const float window = saturate(1.0 - ratio2 * ratio2);
    const float nearest = max(distanceToLight, max(light.radius, 0.01));
    return window * window / (nearest * nearest) * cone;
}

// Transforms a normal with the cofactor matrix, which stays correct under non-uniform scale and
// needs no inverse.
float3 TransformNormal(float4x4 world, float3 normal) {
    const float3 x = float3(world[0][0], world[1][0], world[2][0]);
    const float3 y = float3(world[0][1], world[1][1], world[2][1]);
    const float3 z = float3(world[0][2], world[1][2], world[2][2]);
    return cross(y, z) * normal.x + cross(z, x) * normal.y + cross(x, y) * normal.z;
}

// The light the sky sends along a direction, from where it is seen, or black without a sky (ADR-0036).
// Sky cubes keep the faces of the legacy engine, which was left-handed: the engine's -Z is their +Z. The
// sky is turned by its yaw: the direction is turned back before the cube is read.
float3 SkyRadiance(FrameData frame, float3 direction) {
    if (frame.skyTexture == kNoTexture) {
        return float3(0.0, 0.0, 0.0);
    }
    const float c = cos(frame.skyYaw);
    const float s = sin(frame.skyYaw);
    const float3 turned = float3(c * direction.x - s * direction.z, direction.y, s * direction.x + c * direction.z);
    const float3 cube = float3(turned.x, turned.y, -turned.z);
    return g_cubeTextures[frame.skyTexture].SampleLevel(g_samplers[kSamplerLinearClamp], cube, 0.0).rgb *
           frame.skyIntensity;
}

#endif
