#ifndef DAIDALOS_MESH_TYPES_SLANGH
#define DAIDALOS_MESH_TYPES_SLANGH

// Each structure matches its C++ twin in engine/renderer/src/MeshPass.cpp.

// Indices only: everything else is in storage buffers.
struct MeshPushConstants {
    uint frameBuffer;
    uint instanceBuffer;
    uint materialBuffer;
    uint instanceIndex;
    uint materialIndex;
};

struct FrameData {
    float4x4 viewProjection;
    float4x4 inverseViewProjection;
    float3 cameraPosition;
    float fogDensity;
    float3 fogColor;
    uint lightCount;
    float3 ambient;
    uint lightBuffer;
    uint skyTexture;     // Index in g_cubeTextures, or kNoTexture for no sky.
    float skyIntensity;  // Multiplies the sky's colors.
    uint padding0;
    float normalStrength; // Multiplies every normal map's tilt.
    float3 ambientBelow;  // Ambient light from below; ambient comes from above.
    uint occlusionTexture; // Half-resolution ambient occlusion, or kNoTexture.
    float2 screenTexel;    // One pixel of the frame, in texture coordinates.
    float nearPlane;       // Of the camera: LinearDepth turns a depth into meters.
    uint clusterBuffer;    // For each cluster, the first of its lights in clusterLightBuffer, and their count.
    float3 cameraForward;
    float clusterSliceScale; // A depth's slice is log(depth / nearPlane) * clusterSliceScale.
    uint clusterLightBuffer; // Indices into lightBuffer.
    float farPlane;          // Nothing is drawn beyond it: the view distance.
    uint accelerationStructure; // The frame's top-level structure in g_accelerationStructures.
    uint padding;
};

// Meters in front of the camera, from a reverse-Z depth: 1 at the near plane, 0 at the far plane.
float LinearDepth(FrameData frame, float depth) {
    return frame.nearPlane * frame.farPlane / (depth * (frame.farPlane - frame.nearPlane) + frame.nearPlane);
}

// Matches renderer/src/LightClusters.hpp.
static const uint kClusterColumns = 16;
static const uint kClusterRows = 9;
static const uint kClusterSlices = 24;

// A point light has a cosOuter of -2, which every direction passes.
struct LightData {
    float3 position;
    float range;
    float3 direction;
    float fullRange; // Meters lit at full strength.
    float3 color;
    float cosOuter;
    float cosInner;
    uint padding0;
    uint2 padding;
};

// One per draw of the frame, in the order of the sorted draws; also what a ray hit's custom index points to.
// A skinned draw's vertices were skinned by the frame's skinning pass, in world space: its world is identity.
struct InstanceData {
    float4x4 world;
    uint vertexBuffer; // Storage index of the vertices, kVertexFloats floats each.
    uint firstVertex;  // Of the draw, in vertexBuffer.
    uint indexBuffer;  // Storage index of the 32-bit indices.
    uint material;
};

// Floats per vertex: position, normal, tangent and uv, as resources::Vertex.
static const uint kVertexFloats = 12;

// One per joint of the frame's skinned draws: its world matrix times its inverse bind matrix.
struct JointData {
    float4x4 matrix;
};

// Matches resources::SkinWeights: four 16-bit joint indices, then four weights. The weights are
// separate floats, so that the structure keeps the 24 bytes of its twin.
struct SkinVertex {
    uint joints01;
    uint joints23;
    float weight0;
    float weight1;
    float weight2;
    float weight3;
};

static const uint kNoTexture = 0xFFFFFFFF;

struct MaterialData {
    float4 baseColorFactor;
    float3 emissiveFactor;
    float metallicFactor;
    float roughnessFactor;
    float normalScale;
    float occlusionStrength;
    float alphaCutoff;
    uint baseColorTexture;
    uint metallicRoughnessTexture;
    uint normalTexture;
    uint occlusionTexture;
    uint emissiveTexture;
};

// Fullscreen passes declare their own push constants.
#ifndef DAI_NO_MESH_PUSH_CONSTANTS
[[vk::push_constant]] MeshPushConstants g_push;
#endif
[[vk::binding(0, 0)]] Texture2D g_textures[];
[[vk::binding(1, 0)]] SamplerState g_samplers[4];
[[vk::binding(5, 0)]] TextureCube g_cubeTextures[];
[[vk::binding(2, 0)]] StructuredBuffer<FrameData> g_frames[];
[[vk::binding(2, 0)]] StructuredBuffer<InstanceData> g_instances[];
[[vk::binding(2, 0)]] StructuredBuffer<MaterialData> g_materials[];
[[vk::binding(2, 0)]] StructuredBuffer<JointData> g_joints[];
[[vk::binding(2, 0)]] StructuredBuffer<SkinVertex> g_skins[];
[[vk::binding(2, 0)]] StructuredBuffer<LightData> g_lights[];
[[vk::binding(2, 0)]] StructuredBuffer<uint2> g_clusters[];
[[vk::binding(2, 0)]] StructuredBuffer<uint> g_clusterLights[];

// Matches rhi::SamplerIndex.
static const uint kSamplerLinearClamp = 0;
static const uint kSamplerLinearRepeat = 1;
static const uint kSamplerNearestClamp = 2;
static const uint kSamplerShadowCompare = 3;

// The cluster of a pixel: its tile of the screen, and its slice of depth (ADR-0008).
uint ClusterOf(FrameData frame, float2 pixel, float3 worldPosition) {
    const float2 tile = pixel * frame.screenTexel * float2(kClusterColumns, kClusterRows);
    const uint column = min(uint(tile.x), kClusterColumns - 1);
    const uint row = min(uint(tile.y), kClusterRows - 1);
    const float depth = max(dot(worldPosition - frame.cameraPosition, frame.cameraForward), frame.nearPlane);
    const uint slice = min(uint(max(log(depth / frame.nearPlane) * frame.clusterSliceScale, 0.0)), kClusterSlices - 1);
    return column + row * kClusterColumns + slice * kClusterColumns * kClusterRows;
}

// How much of a light reaches a point: full up to fullRange, then fading linearly to zero at the range,
// and inside the cone of a spot light.
float Attenuation(LightData light, float distanceToLight, float3 toLight) {
    const float distance = saturate((light.range - distanceToLight) / max(light.range - light.fullRange, 0.0001));
    const float cone = smoothstep(light.cosOuter, light.cosInner, dot(-toLight, light.direction));
    return distance * cone;
}

// Transforms a normal with the cofactor matrix, which stays correct under non-uniform scale and
// needs no inverse.
float3 TransformNormal(float4x4 world, float3 normal) {
    const float3 x = float3(world[0][0], world[1][0], world[2][0]);
    const float3 y = float3(world[0][1], world[1][1], world[2][1]);
    const float3 z = float3(world[0][2], world[1][2], world[2][2]);
    return cross(y, z) * normal.x + cross(z, x) * normal.y + cross(x, y) * normal.z;
}

// The light the sky sends along a direction, from where it is seen, or black without a sky (ADR-0036).
// Sky cubes keep the faces of the legacy engine, which was left-handed: the engine's -Z is their +Z.
float3 SkyRadiance(FrameData frame, float3 direction) {
    if (frame.skyTexture == kNoTexture) {
        return float3(0.0, 0.0, 0.0);
    }
    const float3 cube = float3(direction.x, direction.y, -direction.z);
    return g_cubeTextures[frame.skyTexture].SampleLevel(g_samplers[kSamplerLinearClamp], cube, 0.0).rgb *
           frame.skyIntensity;
}

#endif
