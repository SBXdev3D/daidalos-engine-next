#ifndef DAIDALOS_GBUFFER_SURFACE_SLANGH
#define DAIDALOS_GBUFFER_SURFACE_SLANGH

#include "Decals.slangh"
#include "Wetness.slangh"

// The G-buffer's pixel shader (ADR-0044), which the meshes (GBuffer.slang) and mesh particles
// (ParticleMesh.slang, ADR-0053) share. Include after MeshCommon.slangh.


struct GBufferOutput {
    // The world normal, times 0.5 plus 0.5, and the roughness.
    float4 normal : SV_Target0;
    // Where the surface was in the previous frame minus where it is, in texture coordinates.
    float2 motion : SV_Target1;
    // The base color, in an sRGB target, and the metalness in alpha, which stays linear.
    float4 baseColor : SV_Target2;
    // The emission in nits, times the frame's exposure (ADR-0043), and the material's occlusion in alpha.
    float4 emission : SV_Target3;
    // The clear coat and the sheen (PackLayers, ADR-0056).
    uint2 layers : SV_Target4;
};

GBufferOutput PSMain(VertexOutput input, bool isFrontFace : SV_IsFrontFace) {
    const FrameData frame = g_frames[g_push.frameBuffer][0];
    const MaterialData material = g_materials[g_push.materialBuffer][g_push.materialIndex];
    float4 baseColor = BaseColor(material, input.uv); // Discards below the alpha cutoff.
    float3 normal = SurfaceNormal(input, isFrontFace, material, frame.normalStrength);
    // glTF: roughness in green, metalness in blue.
    const float4 metallicRoughness = SampleTexture(material.metallicRoughnessTexture, input.uv, float4(1.0, 1.0, 1.0, 1.0));
    float metallic = saturate(material.metallicFactor * metallicRoughness.b);
    float roughness = clamp(material.roughnessFactor * metallicRoughness.g, 0.045, 1.0);
#ifndef DAI_NO_INSTANCE_EMISSIVE_SCALE
    // Decals (ADR-0060): blood, grime, holes, over the material.
    {
        const float footprint = max(length(ddx(input.worldPosition)), length(ddy(input.worldPosition)));
        ApplyDecals(frame, g_instances[g_push.instanceBuffer][g_push.instanceIndex].decalMask, input.worldPosition,
                    footprint, baseColor.rgb, metallic, roughness, normal);
    }
#endif
    // Water (ADR-0061): a film, puddles, streaks, over the material and its decals.
    Layers layers;
    layers.coat = material.clearcoat;
    layers.coatRoughness = material.clearcoatRoughness;
    layers.sheen = material.sheenColor;
    layers.sheenRoughness = material.sheenRoughness;
    ApplyWetness(frame, input.worldPosition, normalize(input.worldNormal) * (isFrontFace ? 1.0 : -1.0), material.porosity,
                 baseColor.rgb, roughness, normal, layers);
    const float occlusion =
        lerp(1.0, SampleTexture(material.occlusionTexture, input.uv, float4(1.0, 1.0, 1.0, 1.0)).r, material.occlusionStrength);
    float3 emission = material.emissiveFactor *
                      SampleTexture(material.emissiveTexture, input.uv, float4(1.0, 1.0, 1.0, 1.0)).rgb * frame.exposure;
#ifndef DAI_NO_INSTANCE_EMISSIVE_SCALE
    // An animated lamp's glow (ADR-0057).
    emission *= g_instances[g_push.instanceBuffer][g_push.instanceIndex].emissiveScale;
#endif

    GBufferOutput output;
    output.normal = float4(normal * 0.5 + 0.5, roughness);
    output.motion = ClipToUv(input.previousClip) - ClipToUv(input.currentClip);
    output.baseColor = float4(baseColor.rgb, metallic);
    output.emission = float4(emission, occlusion);
    output.layers = PackLayers(layers.coat, layers.coatRoughness, layers.sheen, layers.sheenRoughness);
    return output;
}

#endif
