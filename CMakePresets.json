{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static-md" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Debug and Release)",
      "inherits": "windows-base"
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC with AddressSanitizer",
      "inherits": "windows-base",
      "cacheVariables": { "DAI_ENABLE_ASAN": "ON" }
    },
    {
      "name": "windows-msvc-profile",
      "displayName": "Windows MSVC with the Tracy profiler",
      "inherits": "windows-base",
      "cacheVariables": { "DAI_ENABLE_PROFILER": "ON", "VCPKG_MANIFEST_FEATURES": "profiler" }
    },
    {
      "name": "windows-msvc-shipping",
      "displayName": "Windows MSVC Release for the release archive, without developer tools or tests",
      "inherits": "windows-base",
      "cacheVariables": { "DAI_ENABLE_DEV_TOOLS": "OFF", "DAI_BUILD_TESTS": "OFF" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux Clang Debug with AddressSanitizer and UBSan",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DAI_ENABLE_ASAN": "ON" }
    },
    {
      "name": "linux-clang-profile",
      "displayName": "Linux Clang RelWithDebInfo with the Tracy profiler",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DAI_ENABLE_PROFILER": "ON",
        "VCPKG_MANIFEST_FEATURES": "profiler"
      }
    },
    {
      "name": "linux-clang-shipping",
      "displayName": "Linux Clang Release for the release archive, without developer tools or tests",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DAI_ENABLE_DEV_TOOLS": "OFF", "DAI_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan", "configuration": "Debug" },
    { "name": "windows-msvc-profile", "configurePreset": "windows-msvc-profile", "configuration": "RelWithDebInfo" },
    { "name": "windows-msvc-shipping", "configurePreset": "windows-msvc-shipping", "configuration": "Release" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-profile", "configurePreset": "linux-clang-profile" },
    { "name": "linux-clang-shipping", "configurePreset": "linux-clang-shipping" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "windows-msvc-debug", "inherits": "test-base", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-msvc-release", "inherits": "test-base", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-asan", "inherits": "test-base", "configurePreset": "windows-msvc-asan", "configuration": "Debug" },
    { "name": "windows-msvc-profile", "inherits": "test-base", "configurePreset": "windows-msvc-profile", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-debug", "inherits": "test-base", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "inherits": "test-base", "configurePreset": "linux-clang-release" },
    {
      "name": "linux-clang-asan",
      "inherits": "test-base",
      "configurePreset": "linux-clang-asan",
      "environment": { "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp:print_suppressions=0" }
    },
    { "name": "linux-clang-profile", "inherits": "test-base", "configurePreset": "linux-clang-profile" }
  ],
  "packagePresets": [
    {
      "name": "windows-msvc-shipping",
      "configurePreset": "windows-msvc-shipping",
      "configurations": ["Release"],
      "packageDirectory": "${sourceDir}/build/packages"
    },
    {
      "name": "linux-clang-shipping",
      "configurePreset": "linux-clang-shipping",
      "packageDirectory": "${sourceDir}/build/packages"
    }
  ]
}
