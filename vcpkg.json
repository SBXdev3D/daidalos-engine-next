{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "daidalos-engine-next",
  "version-string": "0.1.0",
  "dependencies": [
    "directx-dxc",
    "glm",
    "gtest",
    "imgui",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "x11",
          "platform": "linux"
        }
      ]
    },
    "spdlog",
    "tl-expected",
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator"
  ],
  "features": {
    "profiler": {
      "description": "Tracy profiler client (DAI_ENABLE_PROFILER)",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  }
}
